<?xml version="1.0" encoding="utf-8"?><!--
  Android Lint 的取舍表。**每条 ignore 都要写清为什么** —— 关掉的检查不会自己回来，
  而「因为吵」是最贵的理由：下次真出问题时也没人看得见。

  这里只放两类：本仓库刻意为之的，以及规则本身对中文判断失真的。
  其余警告一律留着可见 —— 「有新版本可用」这类提示正是要定期看一眼的。
-->
<lint>
  <!-- 只发 arm64 是有意的：APK 里 160MB 主要是内嵌 Node 运行时，多一个 ABI 就翻倍。
       ChromeOS 的 x86_64 不在目标内（模拟器调试另有 -Pfactotum.abis=x86_64）。 -->
  <issue id="ChromeOsAbiSupport" severity="ignore" />

  <!-- debug-only 的广播入口靠 `adb shell am broadcast`（uid 2000）触发，必须 exported；
       给它加 android:permission 正好会挡住 adb。release 变体不含这些接收器。 -->
  <issue id="ExportedReceiver">
    <ignore path="src/debug/AndroidManifest.xml" />
  </issue>

  <!-- ChatGlyphs 的 modifier 默认值就是该字形自己的尺寸（Modifier.size(22.dp)），
       这是刻意的 API 形状：调用方不传也能得到正确大小。 -->
  <issue id="ModifierParameter">
    <ignore path="src/main/java/com/factotum/app/ui/chat/ChatGlyphs.kt" />
  </issue>

  <!-- 这条规则按英文判断「拼接处少了个空格」，而中文拼接本来就不加空格。
       本仓库的提示语全是中文，留着它只会长期误报。 -->
  <issue id="TextConcatSpace" severity="ignore" />
</lint>
