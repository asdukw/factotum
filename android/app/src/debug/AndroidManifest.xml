<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 仅 debug 构建存在：执行层动作 / 内嵌 Node 的 adb 触发入口（release 不含这些类） -->
    <application>
        <receiver
            android:name=".accessibility.DeviceActionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.zoneu.app.debug.ACTION" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".node.NodeDebugReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.zoneu.app.debug.NODE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".voice.VoiceDebugReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.zoneu.app.debug.VOICE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
