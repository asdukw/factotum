<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 应用内更新：把验证过的 APK 交给系统安装器。Android 8+ 还要用户为「这个来源」
         手动打开「安装未知应用」，由 AppUpdater.canInstall 判断并引导。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 定时任务：精确到分钟的唤醒。Android 12+ 是特殊权限，用户要在系统里手动开；
         没开时降级成 setWindow（可能晚几分钟），功能不会消失。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 任务期间保活（ColorOS 会冻结后台进程）；通知在 13+ 需要运行时权限，拒绝也允许 FGS 运行 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 语音输入：麦克风。音频只在本进程内存里活到识别完（本地模型，不出设备），
         权限弹窗由聊天页的麦克风按钮触发。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 设置闹钟（set_alarm → AlarmClock.ACTION_SET_ALARM）。AOSP / Pixel 的 DeskClock 把
         处理这个 action 的 HandleSetApiCalls 声明成 android:permission=...SET_ALARM，
         不声明就 SecurityException（模拟器实测）。protectionLevel=normal，装包即授，
         不弹框。厂商时钟（ColorOS 等）不校验它，所以真机上不声明也「碰巧」能用。 -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- 静默建日程（add_calendar_event → ContentResolver.insert）。
         READ 只为查「哪个日历可写」，但一旦授予就等于能读用户**整本日历** —— 这是一次
         隐私边界的移动（AGENTS.md §6.1），因此授权入口只在聊天里、由一次真实的日程动作
         失败后触发，不在启动时索要。开着 App 不用日程的人，这两条权限永远是未授予。 -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- 让启动器类 App 对 launch_app 可见（不针对任何具体 App） -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".FactotumApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Factotum">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 任务期间的前台服务：只保活 + 挂通知，不承载逻辑 -->
        <service
            android:name=".node.NodeTaskService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 执行层：控件树优先、截图兜底；能力声明见 res/xml/accessibility_service_config.xml -->
        <service
            android:name=".accessibility.FactotumAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
        <!-- 应用内更新：cacheDir 里的 APK 通过 content:// 交给系统安装器。
             exported=false + 只授读权限，别的应用拿不到这个目录。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- 定时任务：闹钟响 → 跑任务；开机 / 改时间 → 重排（alarm 不持久化）。 -->
        <receiver
            android:name=".schedule.ScheduledTaskReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.factotum.app.schedule.FIRE" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".schedule.ScheduledTaskBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <!-- 用户授予 / 撤销「闹钟和提醒」：重排，把窗口闹钟升级成精确闹钟。 -->
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- 定时任务权限提醒：每 6 小时查一次「有任务但没有精确闹钟权限」，最多每天提醒一次。 -->
        <receiver
            android:name=".schedule.ExactAlarmMonitorReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.factotum.app.schedule.CHECK_EXACT_ALARM" />
            </intent-filter>
        </receiver>
        <!-- 静默写操作的流体云/通知回执：ongoing 通知划不掉，用户点「关闭」时由它取消。 -->
        <receiver
            android:name=".device.NoticeDismissReceiver"
            android:exported="false" />
    </application>

</manifest>
